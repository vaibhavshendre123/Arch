# Production frontend configuration.
#
# This file is committed because it contains only a public origin, never a secret.
# Vite loads it for `vite build` (mode=production). A VITE_API_BASE_URL set in the
# hosting dashboard still takes precedence over the value here.
#
# The API runs as a separate Render service, so browser requests are cross-origin.
# The backend's CORS allowlist must include this frontend origin; see docs/DEPLOYMENT.md.
VITE_API_BASE_URL=https://arch-t63z.onrender.com/api
